# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (Supabase PostgreSQL) ────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres"

# ── JWT ───────────────────────────────────────────────────
# Must be at least 64 characters
JWT_SECRET="your-super-secret-jwt-key-minimum-64-characters-long-replace-this"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-minimum-64-characters-long-replace"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Client URL (CORS) ─────────────────────────────────────
# Primary frontend origin. In production set this to the live domain, e.g.
# CLIENT_URL="https://shopflow-theta.vercel.app"
CLIENT_URL="http://localhost:3000"

# Extra allowed CORS origins (comma-separated) — add production/custom domains
# here without editing source, e.g.
# CORS_EXTRA_ORIGINS="https://shopflow-theta.vercel.app,https://shopflow.az"
CORS_EXTRA_ORIGINS=""

# Allow this project's Vercel preview deployments (shopflow-*.vercel.app).
# "true" or "false" (default). Enable only where preview access is needed.
CORS_ALLOW_VERCEL_PREVIEWS="false"

# ── Refresh-token cookie SameSite ─────────────────────────
# Leave UNSET for the default: 'none' in production, 'lax' otherwise.
# On *.vercel.app the frontend and API are cross-site, so the refresh cookie must
# be SameSite=None (+ Secure) or hard reloads log users out (issue #90). When the
# API is same-site with the frontend (e.g. shopflow.az + api.shopflow.az) set
# COOKIE_SAMESITE="lax" to drop the third-party cookie and harden against CSRF.
# COOKIE_SAMESITE="lax"

# ── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# ── Resend (Email) ────────────────────────────────────────
RESEND_API_KEY="re_your-resend-api-key"
# EMAIL_FROM's domain MUST be verified in the Resend dashboard
# (https://resend.com/domains). Public mailbox domains (gmail.com, outlook.com,
# yahoo.com, …) can NEVER be verified — sending from one fails with a 403
# "domain is not verified" and every verification/reset email silently drops
# (issue #89). For local testing use "onboarding@resend.dev" (Resend's shared
# domain; delivers only to the account owner's verified address).
EMAIL_FROM="ShopFlow <no-reply@shopflow.az>"

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Admin seed (npm run prisma:seed:admin) ────────────────
# Credentials for the env-driven admin seed. Put REAL values only in .env
# (which is gitignored) — never commit them.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="ShopFlow Admin"
